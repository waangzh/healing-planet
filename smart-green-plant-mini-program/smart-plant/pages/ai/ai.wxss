/* pages/ai/ai.wxss */
.ai-page {
	height: 100vh;
	display: flex;
	flex-direction: column;
	background-color: #f7f7f7;
	padding-bottom: 120rpx;
}

.chat-body {
	flex: 1;
	padding: 20rpx 0 20rpx 0;
	background: #f7f7f7;
	box-sizing: border-box;
	width: 100%;
	-webkit-overflow-scrolling: touch;
	scroll-behavior: smooth;
}

.chat-header {
	position: sticky;
	top: 0;
	z-index: 100;
	padding: 20rpx 32rpx;
	display: flex;
	align-items: center;
	gap: 16rpx;
	background: #fff;
	border-bottom: 1rpx solid #eee;
}

.ai-avatar {
	width: 80rpx;
	height: 80rpx;
	border-radius: 50%;
}

.ai-name {
	font-size: 32rpx;
	font-weight: 500;
}

.status {
	font-size: 24rpx;
	color: #07c160;
	margin-left: auto;
	background-color: #e8f8f0;
	padding: 6rpx 16rpx;
	border-radius: 24rpx;
}

.message-item {
	display: flex;
	gap: 20rpx;
	margin-bottom: 32rpx;
	padding: 0 20rpx;
}

.message-item.user {
	flex-direction: row-reverse;
}

.avatar {
	width: 72rpx;
	height: 72rpx;
	border-radius: 50%;
	flex-shrink: 0;
}

.message-content {
	max-width: 60%;
}

.message-text {
	display: inline-block;
	padding: 16rpx 24rpx;
	font-size: 28rpx;
	line-height: 1.5;
	border-radius: 36rpx;
	word-break: break-all;
}

.user .message-text {
	background: #07c160;
	color: #fff;
	border-radius: 36rpx;
}

.ai .message-text {
	background: #fff;
	color: #333;
	border-radius: 36rpx;
}

.chat-footer {
	position: fixed;
	bottom: 0rpx;
	left: 0;
	right: 0;
	padding: 20rpx 32rpx;
	background: #fff;
	border-top: 1rpx solid #eee;
}

.input-area {
	display: flex;
	gap: 16rpx;
	align-items: center;
}

.message-input {
	flex: 3;
	height: 68rpx;
	padding: 0 24rpx;
	background: #f7f7f7;
	border-radius: 34rpx;
	font-size: 28rpx;
}

.send-button {
	flex: 1;
	min-width: 100rpx;
	height: 68rpx;
	line-height: 68rpx;
	background: #07c160;
	color: #fff;
	border-radius: 34rpx;
	font-size: 28rpx;
	padding: 0 20rpx;
}

.send-button::after {
	display: none;
}

.send-button.loading {
	opacity: 0.7;
}

.empty-state {
	padding: 200rpx 0;
	text-align: center;
	color: #999;
	font-size: 28rpx;
}

/* Markdown内容样式 */
.markdown-content {
	line-height: 1.6;
	font-size: 28rpx;
}

.markdown-content code {
	background: #f5f5f5;
	padding: 4rpx 8rpx;
	border-radius: 4rpx;
	font-family: monospace;
	font-size: 24rpx;
}

.markdown-content pre {
	background: #f5f5f5;
	padding: 20rpx;
	border-radius: 8rpx;
	overflow-x: auto;
	margin: 20rpx 0;
}

.markdown-content pre code {
	background: none;
	padding: 0;
}

.markdown-content p {
	margin: 16rpx 0;
}

.markdown-content h1,
.markdown-content h2,
.markdown-content h3,
.markdown-content h4,
.markdown-content h5,
.markdown-content h6 {
	font-weight: bold;
	margin: 24rpx 0 16rpx 0;
}

.markdown-content a {
	color: #07c160;
	text-decoration: underline;
}

.markdown-content ul,
.markdown-content ol {
	padding-left: 40rpx;
	margin: 16rpx 0;
}

.markdown-content li {
	margin: 8rpx 0;
}