.tool-container {
  
  padding: 30rpx;
  padding-top: 270rpx;
  background-color: #f5f7fa;
  min-height: 100vh;

  display: flex;
  flex-direction: column;
  align-items: center; 
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 40rpx;
  text-align: center;
}

.card {
  margin-top: 30rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.1);
  width: 350rpx;
  margin-bottom: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.card-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.card-desc {
  font-size: 24rpx;
  color: #888;
}
