/**index.wxss**/
.page-container{
  padding:25rpx;
  justify-content: center;
  align-items: center;
  height: 100%;
  background-color: rgb(242, 242, 242);
}

.header-container{
  background-color: lightgreen;
  color:beige;
  height: 300rpx;
  margin: 0 16rpx;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.3);
  border-radius: 32rpx;
  padding: 32rpx 32rpx;
}
@font-face {
  font-family: "阿里妈妈方圆体 VF Regular";
  src: url(/static/fonts/AlimamaFangYuanTiVF-Thin.ttf) format("truetype");
  font-display: swap;
}
.welcome_text{
  font-size: 30rpx;
  height: 50rpx;
  line-height: 50rpx;
  /* font-style:oblique; */
  font-family: "阿里妈妈方圆体 VF Regular", sans-serif;
  text-align: center;
  width: 450rpx;
  color: rgb(128, 124, 94);
  background-color: aqua;
  margin-left: 70rpx;
  border-radius: 20rpx;
}
.w50{
  width: 50%;
}
.location_style{
  margin-top: 40rpx;
  height: 40rpx;
}
.temperature_style{
  margin-top: 15rpx;
  margin-bottom: 15rpx;
  margin-left: 30rpx;
  font-size: 80rpx;
  font-weight: 800;
  color: #fff;
}
.precip_style{
  margin-left: 25rpx;
  color: rgb(147, 150, 137);
  font-size: 30rpx;
}
.forecast{
  padding: 20rpx;
  margin-top: 10rpx;
}
.threeday{
  text-align: center;
  justify-content: center;
  margin-left: 35%;
  width: 220rpx;
  height: 60rpx;
  line-height: 60rpx;
  font-weight: bolder;
  background-color: rgb(75, 231, 223);
  font-size: 35rpx;
  border-radius: 10rpx;
  box-shadow: 0 8rpx 20rpx rgba(0.1,0.2,0.1,0.15);
}
.forecast_card{
  display: flex;
  margin: 30rpx auto;
  padding: 10rpx;
  margin-bottom: 0;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
  background-color: lightskyblue;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.3);
}
.day-forecast {
  flex-basis: calc(25% - 20rpx); /* 每个天气预报块占据约25%，并留出一些间距 */
  background-color: #fff;
  border-radius: 10rpx;
  height: 180rpx;
  padding: 20rpx;
  margin: 10rpx auto;
  box-shadow: 0 4rpx 5rpx rgba(0, 0, 0, 0.2);
}

.date {
  font-size: 24rpx;
  text-align: center;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.weather-icon {
  margin-left: 28%;
  width: 60rpx;
  height: 60rpx;
  margin-top: 20rpx;
  margin-bottom: 10rpx;
}

.temp-range {
  font-size: 22rpx;
  text-align: center;
  margin-top: 10rpx;
  color: rgb(158, 188, 226);
}
.data{
  margin-top: 20rpx;
}
.data-header{
  text-align: center;
  justify-content: center;
  width: 220rpx;
  height: 60rpx;
  margin-left: 35%;
  line-height: 60rpx;
  font-weight: bolder;
  background-color: rgb(75, 231, 223);
  font-size: 35rpx;
  border-radius: 10rpx;
  box-shadow: 0 8rpx 20rpx rgba(0.1,0.2,0.1,0.15);
}
.data-container{
  margin-top: 36rpx;
  display: grid;
  justify-content: center;
  grid-template-columns: repeat(auto-fill,300rpx);
  grid-gap:36rpx;
}

.data-container .data-card{
  background-color: #fff;
  height: 160rpx;
  /* box-shadow: #d6d6d6 0 0 8rpx; */
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.3);
  border-radius: 36rpx;
  display: flex;
  justify-content: space-between;
  padding: 0 16rpx;
}

.data-container .data-card .data-card_icon{
  height: 72rpx;
  width: 72rpx;
  margin-left: 15rpx;
  margin-top: 35rpx;  
}
.data-container .details{
  position: relative;
  width: 220rpx;
}
.data-container .data-card .data-card_title{
  margin-top: 20rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #7f7f7f;
}
.data-container .data-card .data-card_value{
  text-align: center;
  margin-top: 20rpx;
  font-size: 43rpx;
  font-weight: bold;
  color: #7f7f7f;
}

.data-container .data-card .data-card_value_unit{
  font-size: 30rpx;
  color: #7f7f7f;
}
.chart{
  width: 100%; /* 设置宽度为 100%，使其与页面宽度一致 */
  height: 100%; /* 固定高度 */
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  overflow: hidden;
  margin-top: 50;
}

ec-canvas {
  width: 100%;
  height:100%;
}

.chart-container {
  width: 700rpx;
  box-sizing: border-box;
  margin-top: 50rpx;
  padding-top: 20rpx;
  background-color: aqua;
  border-radius: 12rpx;
  margin-left: 8rpx;
  margin-right: 8rpx;
}

.chart-picker {
  width: 700rpx;
  background: #f8f9fa;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
  border-top: 1rpx solid #eee;
  border-bottom: 1rpx solid #eee;
}

.picker-tabs {
  display: flex;
  justify-content: space-around;
  align-items: center;
  margin-left: 10rpx;
}

.picker-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  width: 100%;
  color: #666;
  background-color: transparent;
  border-radius: 20rpx;
  margin: 0 8rpx;
  transition: all 0.3s ease;
}

.picker-tab.active {
  color: #4ECDC4;
  background-color: rgba(78, 205, 196, 0.1);
  font-weight: 600;
}

.chart {
  width: 100%;
  background: #fff;
  border-radius: 0 0 12rpx 12rpx; /* 仅底部有圆角 */
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}
.chart-title {
  font-size: 18px;
  font-weight: bold;
  text-align: center;
  color: #333;
  margin-bottom: 8px;
}

.chart-subtitle {
  font-size: 14px;
  text-align: center;
  color: #666;
  margin-bottom: 16px;
}