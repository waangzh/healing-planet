<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.green.mapper.TipMapper">
    <select id="getRandomTip" resultType="com.green.entity.Tip">
        select *
        from tip
        order by rand()
        limit 1
    </select>
</mapper>
