/* 账号密码登录页样式 */

.page-container {
  height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0 48rpx;
  box-sizing: border-box;
  background: linear-gradient(135deg, #31f937 0%, #00b894 45%, #0fbcf9 100%);
}

.login-card {
  width: 100%;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 56rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.12);
  box-sizing: border-box;
}

.header {
  margin-bottom: 40rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #222222;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 24rpx;
  color: #999999;
}

.input-group {
  margin-top: 28rpx;
  padding: 0 20rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background-color: #f7faff;
  display: flex;
  align-items: center;
  border: 2rpx solid #e0ecff;
}

.login-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}

.text-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.btn-login {
  margin-top: 40rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(90deg, #31f937, #07c160);
  color: #ffffff;
  font-size: 32rpx;
  border: none;
}