/* pages/device/device.wxss */
.scroll-content {
  height: 100%;
  background: linear-gradient(135deg, #f5f7fa 0%, #F6F7F8 100%);
  box-sizing: border-box;
  padding-left: 10rpx;
  padding-right: 10rpx;
  padding-top: 10rpx;
}

/* 设备信息区域 */
.device-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 20rpx 30rpx;
  padding: 30rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.device-selector {
  flex: 1;
}

.selector-label {
  margin-bottom: 10rpx;
}

.label-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.picker-container {
  display: flex;
  align-items: center;
  background-color: #F3FFF4;
  width: fit-content;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
}

.picker-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #27AE60;
}

.picker-arrow {
  width: 24rpx;
  margin-left: 10rpx;
}

.device-status {
  text-align: right;
}

.status-label {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 20rpx;
}

.status-value.online {
  font-size: 32rpx;
  color: #27AE60;
  font-weight: 600;
  background-color: #E8F8F0;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
}

/* 环境监测与智能调节面板 */
.environment-control-panel {
  margin: 30rpx 30rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
}

/* 智能调节开关 */
.smart-control {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.smart-control-left {
  flex: 1;
}

.smart-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.smart-subtitle {
  font-size: 24rpx;
  color: #999;
}

.smart-switch {
  transform: scale(1.1);
}

/* 阈值设置条目 (已修改) */
.threshold-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.threshold-item:last-of-type {
  border-bottom: none;
}

.threshold-header {
  display: flex;
  align-items: center;
}

.threshold-icon {
  width: 70rpx;
  height: 70rpx;
  margin-right: 20rpx;
}

.threshold-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

/* 阈值输入区域 (新增) */
.threshold-inputs {
  display: flex;
  align-items: center;
}

.threshold-input {
  width: 100rpx;
  height: 60rpx;
  background-color: #f7f8fa;
  border: 2rpx solid #e9ecef;
  border-radius: 12rpx;
  text-align: center;
  font-size: 28rpx;
  color: #333;
}

.separator {
  margin: 0 15rpx;
  font-size: 30rpx;
  color: #999;
}

.unit {
  margin-left: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #666;
  width: 60rpx; 
  text-align: left;
}

/* 保存按钮 */
.save-section {
  padding: 20rpx;
  border-top: 2rpx solid #f0f0f0;
}

.save-button {
  width: 100%;
  height: 77rpx;
  background: linear-gradient(135deg, #2ecc71, #27ae60);
  color: white;
  border: none;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 32rpx rgba(46, 204, 113, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.save-button::after {
  border: none;
}

/* 设备控制区域 */
.device-controls-panel {
  margin: 30rpx 30rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
}

.controls-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.controls-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.controls-subtitle {
  font-size: 24rpx;
  color: #999;
}

.control-card {
  border-bottom: 2rpx solid #f0f0f0;
}

.control-card:last-child {
  border-bottom: none;
}

.control-content {
  display: flex;
  align-items: center;
  padding: 30rpx;
}

.control-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 25rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 30rpx;
}

.control-device-icon {
  width: 50rpx;
  height: 50rpx;
}

.fan-bg {
  background: linear-gradient(135deg, #74b9ff, #0984e3);
}

.pump-bg {
  background: linear-gradient(135deg, #00b894, #00a085);
}

.light-bg {
  background: linear-gradient(135deg, #fdcb6e, #e17055);
}

.control-info {
  flex: 1;
}

.control-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.control-desc {
  font-size: 24rpx;
  color: #999;
}

.control-switch {
  transform: scale(1.1);
}