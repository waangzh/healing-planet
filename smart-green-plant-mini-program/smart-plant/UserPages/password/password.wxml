<!--pages/password/password.wxml-->
<view class="page-container">
  <view class="password-edit-section">
    <view class="title">修改密码</view>
    <view class="input-item">
      <text class="label">旧密码</text>
      <input type="password" bindinput="onOldPasswordInput" class="input-field"/>
    </view>
    <view class="input-item">
      <text class="label">新密码</text>
      <input type="password" bindinput="onNewPasswordInput" class="input-field"/>
    </view>
    <view class="input-item">
      <text class="label">确认新密码</text>
      <input type="password" bindinput="onConfirmNewPasswordInput" class="input-field"/>
    </view>
    <button bindtap="saveNewPassword" class="save-button">保存</button>
  </view>
</view>