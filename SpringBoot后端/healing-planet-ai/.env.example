COMMUNITY_DB_URL=jdbc:mysql://host.docker.internal:3306/green_community?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
COMMUNITY_DB_USERNAME=root
COMMUNITY_DB_PASSWORD=change-me

LLM_API_KEY=change-me
LLM_BASE_URL=https://api.openai.com
LLM_MODEL=gpt-4.1-mini

# BGE-M3 使用 OpenAI 兼容的 /v1/embeddings 接口，例如 vLLM 或 Infinity。
EMBEDDING_BASE_URL=http://localhost:8081
EMBEDDING_API_KEY=not-required
EMBEDDING_MODEL=BAAI/bge-m3

QDRANT_HOST=localhost
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
RAG_INTERNAL_API_KEY=replace-with-a-random-secret

# 启用时要求服务兼容 {model,query,documents}，返回 results[index,relevance_score]。
RERANKER_ENABLED=false
RERANKER_BASE_URL=http://localhost:8082
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
