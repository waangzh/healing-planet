<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.example.demos.web.mapper.LocationMapper" >

    <update id="updateLocation" parameterType="com.example.demos.web.pojo.entity.LocationData">
        update location_data
        <set>
            <if test="deviceId!=null">
                device_id=#{deviceId},
            </if>
            <if test="address !=null">
                address=#{address},
            </if>
            <if test="location!=null">
                location=#{location},
            </if>
            <if test="city!=null">
                city=#{city},
            </if>
            <if test="province !=null">
                province=#{province}
            </if>
        </set>
        where device_id=#{deviceId}
    </update>

    <insert id="insertLocation" useGeneratedKeys="true" keyProperty="id">
        insert into location_data(device_id, address, location, province, city)
        values (#{deviceId},#{address},#{location},#{province},#{city})
    </insert>
</mapper>