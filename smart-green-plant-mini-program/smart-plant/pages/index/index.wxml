<!--index.wxml-->

<view class="page-container">
<!-- 头部 -->
<!-- 实时天气预报 -->
<view class="header-container">
  <view class="welcome_text">
    欢迎欢迎，今天的天气是{{welcome}}天
  </view>
  <view class="flex">
    <view class="w50">
      <image src="{{'/static/weather/' + currentWeather.weatherIcon + '.svg'}}" 
      style="width:300rpx;margin-top:-20rpx;margin-left:-10rpx;" mode="widthFix" />
    </view>
    <view>
      <view class="location_style">
        <image src="/static/weather/location.png" 
        style="width: 32rpx;" mode="widthFix"/>
        <text style="font-size:32rpx; margin-left: 10rpx;font-weight: 550;color: rgb(75, 162, 189);">{{location}}</text>
      </view>
      <view class="temperature_style">
        {{currentWeather.temp}}℃
      </view>
      <view class="precip_style">
        降水量：{{currentWeather.precip}}ml
      </view>
    </view>
  </view>
</view>
<!-- 三天天气预报 -->
  <view class="forecast">
    <view class="threeday"> 
      未来三天
    </view>
    <view class="forecast_card">
      <block wx:for="{{weatherForecast}}" wx:key="index">
      <view class="day-forecast">
        <view class="date">{{item.date}}</view>
        <image class="weather-icon" src="{{'/static/weather/' + item.weatherIcon + '.svg'}}" mode="aspectFit"></image>
        <view class="temp-range">{{item.tempRange}}℃</view>
      </view>
    </block>
    </view>
  </view>
<!-- 数据部分 -->
  <view class="data">
  <view class="data-header">
      实时监测
  </view>
  <view class="data-container">
  <!-- 花盆号 -->
    <view class="data-card">
      <image class="data-card_icon" src="/static/pot.png"/>
      <view class="details">
        <view class="data-card_title">
          花盆
        </view>
        <view class="data-card_value">
          {{potNumber}} <text class="data-card_value_unit">号</text>
        </view>
      </view>
    </view>
  <!-- 温度 -->
    <view class="data-card">
      <image class="data-card_icon" src="/static/tem.png"/>
      <view class="details">
        <view class="data-card_title">
          温度
        </view>
        <view class="data-card_value">
          {{temperature}} <text class="data-card_value_unit">℃</text>
        </view>
      </view>
    </view>
    <!-- 空气湿度 -->
    <view class="data-card">
      <image class="data-card_icon" src="/static/hum.png"/>
      <view class="details">
        <view class="data-card_title">
          空气湿度
        </view>
        <view class="data-card_value">
          {{humidity}} <text class="data-card_value_unit">％</text>
        </view>
      </view>
    </view>
    <!-- 土壤湿度 -->
    <view class="data-card">
      <image class="data-card_icon" src="/static/soil.png"/>
      <view class="details">
        <view class="data-card_title">
          土壤湿度
        </view>
        <view class="data-card_value">
          {{soilMoisture}} <text class="data-card_value_unit">%</text>
        </view>
      </view>
    </view>
    <!-- 二氧化碳含量 -->
    <view class="data-card">
      <image class="data-card_icon" src="/static/co2.png"/>
      <view class="details">
        <view class="data-card_title">
          二氧化碳含量
        </view>
        <view class="data-card_value">
          {{CO2Value}} <text class="data-card_value_unit">ppm</text>
        </view>
      </view>
    </view>
    <!-- 光照 -->
    <view class="data-card">
      <image class="data-card_icon" src="/static/lightlux.png"/>
      <view class="details">
        <view class="data-card_title">
          光照度
        </view>
        <view class="data-card_value">
          {{lightLux}} <text class="data-card_value_unit">Lx</text>
        </view>
      </view>
    </view>
  </view>
  </view>
<!-- 折线图 -->
  <!-- 图表容器 -->
  <view class="chart-container">
    <!--标题 -->
  <view class="chart-title">环境数据趋势</view>
  <view class="chart-subtitle">2025年数据统计</view>
  <!-- 下拉选择框 -->
  <view class="chart-picker">
      <view class="picker-tabs">
        <block wx:for="{{dataTypes}}" wx:key="index">
          <view class="picker-tab {{currentType === index ? 'active' : ''}}" 
                bindtap="changeDataType" 
                data-index="{{index}}">
            {{item.name}}
          </view>
        </block>
      </view>
    </view>
  <!-- 图表 -->
  <view class="chart">
    <ec-canvas 
      id="myEchart" 
      canvas-id="myEchart" 
      ec="{{ ec }}" 
      style="width: 100%; height: 500rpx; margin-top: 20rpx;">
    </ec-canvas>
  </view>
  </view>
</view>

