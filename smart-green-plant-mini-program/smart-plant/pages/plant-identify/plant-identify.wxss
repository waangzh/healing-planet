/* pages/plant-identify/plant-identify.wxss */
page {
  background-color: #f5f5f5;
}

.container {
  padding: 24rpx;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  position: relative;
}

/* 标题样式 */
.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #2c3e50;
  text-align: center;
  margin: 200rpx 0;
  position: relative;
}

.title::after {
  content: "";
  display: block;
  width: 210rpx;
  height: 6rpx;
  background: #07c160;
  margin: 10rpx auto 0;
  border-radius: 3rpx;
}

/* 上传按钮 */
.upload-btn {
  width: 80%;
  margin: 400rpx auto;
  background-color: #07c160;
  color: white;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
  transition: all 0.3s ease;
  border: none;
}

.upload-btn[disabled] {
  opacity: 0.7;
}

.btn-hover {
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 16rpx rgba(7, 193, 96, 0.4);
}

/* 图片预览区域 */
.preview-container {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 30rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  position: relative;
}

.preview {
  border-radius: 12rpx;
  display: block;
}

.preview-tip {
  font-size: 26rpx;
  color: #95a5a6;
  text-align: center;
  margin-top: 20rpx;
  font-style: italic;
}

/* 结果弹窗 */
.result-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #f0f8f1;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.popup-header {
  background-color: #f0f8f1;
  padding: 30rpx 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #e0e0e0;
  position: relative;
}

.popup-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  flex: 1;
}

.popup-close {
  position: absolute;
  right: 30rpx;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
  color: #999;
  padding: 10rpx;
}

.popup-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.popup-image-container {
  width: 100%;
  height: 400rpx;
  padding: 40rpx 0;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #f0f8f1;
}

.popup-image {
  width: 360rpx;
  height: 360rpx;
  border-radius: 80rpx;
  object-fit: cover;
  /* box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1); */
  /* background-color: #fff; */
}

.scroll-result {
  flex: 1;
  background-color: #fff;
  border-radius: 30rpx 30rpx 0 0;
  padding: 30rpx;
  position: relative;
  overflow: hidden;
  margin-bottom: 100rpx;
  box-sizing: border-box;
}

/* Markdown 结果样式 */
.markdown-result {
  font-size: 28rpx;
  line-height: 1.7;
  color: #333;
}

/* 编号标题样式 */
.numbered-heading {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin: 40rpx 0 30rpx;
  position: relative;
  padding-bottom: 15rpx;
}

.numbered-heading::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  width: 60rpx;
  height: 6rpx;
  background-color: #07c160;
  border-radius: 3rpx;
}

.heading-number {
  color: #07c160;
  margin-right: 8rpx;
}

/* 圆点列表项样式 */
.circle-item {
  display: flex;
  margin-bottom: 20rpx;
  align-items: flex-start;
}

.circle-bullet {
  color: #07c160;
  margin-right: 12rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.item-content {
  flex: 1;
}

/* 植物属性样式 */
.plant-property {
  display: flex;
  margin-bottom: 16rpx;
  align-items: center;
}

.property-name {
  font-weight: 500;
  color: #666;
  min-width: 140rpx;
}

.scientific-name {
  color: #07c160;
  font-style: italic;
  font-weight: 500;
}

.chinese-name {
  color: #07c160;
  font-weight: 500;
}

/* 特征样式 */
.feature-heading {
  font-weight: 600;
  margin: 20rpx 0 16rpx;
  color: #333;
}

/* 详细项目样式 */
.detail-item {
  margin: 10rpx 0 10rpx 40rpx;
  display: flex;
  align-items: flex-start;
  position: relative;
}

.square-bullet {
  color: #07c160;
  margin-right: 10rpx;
  font-size: 24rpx;
}

.detail-content {
  flex: 1;
}

/* 养护条目样式 */
.care-item {
  display: flex;
  align-items: center;
  margin: 20rpx 0;
}

.care-icon {
  margin-right: 12rpx;
  font-size: 32rpx;
}

.care-type {
  font-weight: 500;
  color: #666;
  margin-right: 10rpx;
}

/* 特殊样式 */
.light-icon {
  color: #f39c12;
}

.water-icon {
  color: #3498db;
}

.soil-icon {
  color: #8e44ad;
}

.temp-icon {
  color: #e74c3c;
}

.fertilizer-icon {
  color: #27ae60;
}

.temp-range {
  color: #e74c3c;
  font-weight: 500;
}

.ph-value {
  color: #8e44ad;
  font-weight: 500;
}

.special-term {
  color: #3498db;
  font-weight: 500;
}

.growth-stage {
  color: #07c160;
  font-weight: 500;
}

/* 加载状态 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 60rpx 0;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 8rpx solid rgba(7, 193, 96, 0.1);
  border-top-color: #07c160;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 30rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading text {
  font-size: 28rpx;
  color: #7f8c8d;
  margin-top: 20rpx;
}

/* 强调和斜体 */
strong {
  font-weight: 600;
  color: #e74c3c;
}

em {
  font-style: italic;
  color: #9b59b6;
}

/* 链接样式 */
a {
  color: #3498db;
  text-decoration: underline;
}

/* 段落样式 */
p {
  margin-bottom: 16rpx;
}

@media (min-width: 768px) {
  .container {
    max-width: 750rpx;
    margin: 0 auto;
  }

  .preview {
    height: 600rpx;
  }
}