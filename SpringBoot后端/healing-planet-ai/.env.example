COMMUNITY_DB_URL=jdbc:mysql://host.docker.internal:3306/green_community?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
COMMUNITY_DB_USERNAME=root
COMMUNITY_DB_PASSWORD=change-me

LLM_API_KEY=change-me
LLM_BASE_URL=https://api.siliconflow.cn
LLM_MODEL=Qwen/Qwen3.5-397B-A17B
AI_HTTP_CONNECT_TIMEOUT=10s
AI_HTTP_READ_TIMEOUT=60s
AI_HTTP_REACTIVE_READ_TIMEOUT=120s

# 实体消歧使用独立的小模型、确定性短输出、单次尝试和连续失败熔断。
RAG_ENTITY_LLM_MODEL=Qwen/Qwen3.5-4B
RAG_ENTITY_LLM_TEMPERATURE=0.0
RAG_ENTITY_LLM_MAX_TOKENS=160
RAG_ENTITY_LLM_ENABLE_THINKING=false
RAG_ENTITY_LLM_CONNECT_TIMEOUT_MILLIS=1000
RAG_ENTITY_LLM_READ_TIMEOUT_MILLIS=8000
RAG_ENTITY_CIRCUIT_FAILURE_THRESHOLD=3
RAG_ENTITY_CIRCUIT_OPEN_MILLIS=30000

# BGE-M3 使用 OpenAI 兼容的 /v1/embeddings 接口，例如 vLLM 或 Infinity。
EMBEDDING_BASE_URL=http://localhost:8081
EMBEDDING_API_KEY=not-required
EMBEDDING_MODEL=BAAI/bge-m3
# 模型、embedding 文本和 token 分块分别版本化；变更后由受控索引流程补齐。
RAG_EMBEDDING_MODEL_VERSION=BAAI/bge-m3
RAG_EMBEDDING_CONTENT_VERSION=embedding-content-v2
RAG_CHUNK_SCHEMA_VERSION=chunk-schema-v2
RAG_PLANT_GENERAL_CARE_MAX_TOKENS=800
RAG_COMMUNITY_MAX_TOKENS=800
RAG_DISEASE_MAX_TOKENS=800

QDRANT_HOST=localhost
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_DISEASE_COLLECTION=disease_knowledge
RAG_INTERNAL_API_KEY=replace-with-a-random-secret

# 复用现有病害分类服务，响应至少包含 class_name / crop_name / label。
DISEASE_DETECTOR_BASE_URL=http://localhost:5000
DISEASE_DETECTOR_PATH=/classify
RAG_ATTACHMENT_TTL_SECONDS=900
RAG_ATTACHMENT_MAX_ENTRIES=32

# 启用时要求服务兼容 {model,query,documents}，返回 results[index,relevance_score]。
RERANKER_ENABLED=false
RERANKER_BASE_URL=http://localhost:8082
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# 两级重排预算：先限制 logical evidence，再限制每条证据与总 fragment 数。
RERANKER_CANDIDATE_TOP_K=20
RERANKER_MAX_FRAGMENTS_PER_LOGICAL_EVIDENCE=2
RERANKER_MAX_FRAGMENTS_TOTAL=40
RAG_CONTEXT_ASSEMBLY_MAX_FRAGMENTS_PER_LOGICAL_EVIDENCE=2

# 本地 Grafana 登录账号；生产环境必须通过部署系统注入强密码。
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
