<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.green.mapper.FollowMapper">


    <select id="selectFollowerCount" resultType="java.util.Map">
        SELECT parent_id AS userId, COUNT(*) AS cnt
        FROM follow
        WHERE parent_id IN
        <foreach collection="userIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        GROUP BY parent_id
    </select>
    <select id="selectFollowingCount" resultType="java.util.Map">
        SELECT follower_id AS userId, COUNT(*) AS cnt
        FROM follow
        WHERE follower_id IN
        <foreach collection="userIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        GROUP BY follower_id
    </select>

</mapper>
